#ifndef MSL_VECTOR_H_
#define MSL_VECTOR_H_

#include <algorithm>
#include <memory>

/* The parts of <vector> that the game uses so far: the vector of pointers (the Chao::CSD code), the
 * vector of unsigned long values (__vector_val below) and the vector of objects (__vector_obj_imp
 * below, for example for the targets of the DEFENSE_SYSTEM gadget, the CityLaser gadget's weak
 * pointers and the mission messages). Their messages ("vector::reserve length error",
 * "vector::insert length error") are the library's.
 *
 * Every vector of pointers is implemented by one vector of void pointers, through private bases:
 * the GameCube code has, for each pointer type, an out-of-line copy of each member of vector<T *>
 * and of __vector_ptr<T>'s begin, end, back, push_back, pop_back, clear, constructor and
 * destructor, each calling the next layer. __vector_ptr's reserve and erase are inlined into
 * vector<T *>'s, and __vector_imp's pop_back and clear into __vector_ptr's. The names
 * __vector_ptr and __vector_imp are placeholders: the library's names for these internal classes
 * are not recoverable from the game.
 *
 * reserve and insert are only declared: the program uses the game's own void-pointer instances
 * (0x800D15D8 and 0x8006CD9C in the USA release; the insert carries its declared name in all
 * three regions, so push_back's call binds to it). The game's own push_back (0x8006CB24), end()
 * (0x8006CB68) and begin() (0x8006D008) have this header's instructions; its destructor (0x80019890) reads the
 * elements through an accessor (0x80019904) that this header does not declare, so the copies of
 * the destructor that units emit differ from the game's and are weak duplicates that the link
 * discards. */
namespace std {

/* The vector implementation: capacity (paired with the allocator), size, then the elements. */
template <class T, class Allocator> class __vector_imp {
  public:
    typedef T value_type;
    typedef T *iterator;
    typedef size_t size_type;

    __vector_imp() : cap_(0), size_(0), data_(0) {}
    ~__vector_imp() {
        if (data_ != 0) {
            __alloc().deallocate(data_, __cap());
        }
    }

    /* Matching workaround: begin(), end() and back() read the data pointer through the accessor
     * __data(). The game calls begin() and end() out of line (0x8006D008 and 0x8006CB68 in the USA
     * release) from push_back, insert, erase and the vector of pointers' begin() and end(), and
     * with level-1 inlining a function stays out of line only when it calls another inline
     * function. back() does not call end(): the Chao::CSD copy of back() (0x8035F88C) has end()'s
     * arithmetic expanded in place. What the original library's members called is not known;
     * revisit when it is. */
    iterator begin() {
        return __data();
    }
    iterator end() {
        return __data() + size_;
    }
    size_type size() const {
        return size_;
    }
    value_type &back() {
        return *(__data() + size_ - 1);
    }

    void reserve(size_type n);
    void insert(iterator position, size_type n, const value_type &x);
    void push_back(const value_type &x) {
        insert(end(), 1, x);
    }
    void pop_back() {
        --size_;
    }
    /* Defined after the class and not inline: the game has one out-of-line copy (USA 0x800DF450)
     * after the functions of the Tornado gadget's file, its first user. */
    iterator erase(iterator position);
    void clear() {
        size_ = 0;
    }

  private:
    /* Copying is unrecovered in this partial interface: no copy of a pointer or unsigned-long
     * vector has been identified in the game's code. The vector owns data_, so a memberwise copy
     * would free the same buffer twice. Declared only (as in C++03), which also makes an implicit
     * copy of __vector_ptr, __vector_val and the vectors built on them ill-formed. */
    __vector_imp(const __vector_imp &);
    __vector_imp &operator=(const __vector_imp &);

    T *&__data() {
        return data_;
    }
    size_type &__cap() {
        return cap_.first();
    }
    Allocator &__alloc() {
        return cap_.second();
    }

    __compressed_pair<size_type, Allocator> cap_;
    size_type size_;
    T *data_;
};

/* A vector of T pointers stored as void pointers. */
template <class T> class __vector_ptr : private __vector_imp<void *, allocator<void *> > {
    typedef __vector_imp<void *, allocator<void *> > base;

  public:
    typedef size_t size_type;
    typedef T **iterator;

    iterator begin() {
        return (iterator)base::begin();
    }
    iterator end() {
        return (iterator)base::end();
    }
    T *&back() {
        return (T *&)base::back();
    }

    void reserve(size_type n) {
        base::reserve(n);
    }
    void push_back(T *const &x) {
        base::push_back((void *const &)x);
    }
    void pop_back() {
        base::pop_back();
    }
    iterator erase(iterator position) {
        return (iterator)base::erase((void **)position);
    }
    void clear() {
        base::clear();
    }
};

/* A vector of unsigned long values stored as void pointers, in the way of __vector_ptr: the game
 * has an out-of-line copy of each member of vector<unsigned long> and of this layer, each calling
 * the next layer (in the USA release 0x800CC35C-0x800CE4BC, used by the index vectors of the
 * EGG_FLEET and STONE_POLE gadgets). That the library implements this vector with the void-pointer
 * vector, as it does for pointers, is inferred from those copies, which call the void-pointer
 * vector's members; the name __vector_val is a placeholder. */
template <class T> class __vector_val : private __vector_imp<void *, allocator<void *> > {
    typedef __vector_imp<void *, allocator<void *> > base;

  public:
    typedef size_t size_type;
    typedef T *iterator;

    iterator begin() {
        return (iterator)base::begin();
    }
    iterator end() {
        return (iterator)base::end();
    }
    bool empty() const {
        return base::size() == 0;
    }
    void clear() {
        base::clear();
    }
    void reserve(size_type n) {
        base::reserve(n);
    }
    void push_back(const T &x) {
        base::push_back((void *const &)x);
    }
};

/* Assignment loops for elements that are objects (and, for __vector_imp's erase, void pointers).
 * The game has an out-of-line copy of each wrapper and of each loop for objects, the wrapper
 * calling the loop; for void pointers the loop has no inline call and is expanded into the wrapper
 * (0x800DF4B4 in the USA release). The names are placeholders. */
template <class T> inline T *__copy_objects_loop(T *first, T *last, T *result) {
    for (; first < last; ++first, ++result) {
        *result = *first;
    }
    return result;
}
template <class T> inline T *__copy_objects(T *first, T *last, T *result) {
    return __copy_objects_loop(first, last, result);
}

template <class T> inline T *__copy_backward_objects_loop(T *first, T *last, T *result) {
    while (last > first) {
        --result;
        --last;
        *result = *last;
    }
    return result;
}
template <class T> inline T *__copy_backward_objects(T *first, T *last, T *result) {
    return __copy_backward_objects_loop(first, last, result);
}

template <class T> inline void __fill_objects(T *first, size_t count, const T &value) {
    for (; count != 0; ++first, --count) {
        *first = value;
    }
}

template <class T, class Allocator>
typename __vector_imp<T, Allocator>::iterator __vector_imp<T, Allocator>::erase(iterator position) {
    iterator old_end = end();
    if (old_end - position - 1 != 0) {
        __copy_objects(position + 1, old_end, position);
    }
    --size_;
    return position;
}

/* The implementation of the vectors of objects (placeholder name), with the layout of
 * __vector_imp. The game keeps out-of-line copies, for the element types whose vectors use them,
 * of its constructors and destructor, begin(), end(), back(), capacity(), max_size(), push_back(),
 * pop_back(), insert(), erase(), reserve(), clear(), swap() and the accessors __data(), __cap()
 * and __alloc() (for the DEFENSE_SYSTEM gadget's targets in the USA release, capacity() is
 * 0x8022503C and max_size() 0x80225064), and of the constructors and swaps of the capacity pair:
 * with level-1 inlining an inline function stays out of line when its body calls another inline
 * function, and calls in the arguments of an expanded call are not expanded. empty() calls no
 * inline function and is expanded: the vectors' own empty() read the size in place (0x802ED01C
 * for the count messages and 0x802EECDC for the timer messages). */
template <class T, class Allocator> class __vector_obj_imp {
  public:
    typedef T value_type;
    typedef T *iterator;
    typedef size_t size_type;

    __vector_obj_imp() : cap_(0), size_(0), data_(0) {}
    /* reserve and insert build the new storage in a vector made with this one's allocator. */
    explicit __vector_obj_imp(const Allocator &a) : cap_(a, 0), size_(0), data_(0) {}
    /* Defined after the class and not inline: the vector's destructor (0x80224508) tests its
     * object twice, having the implicit destructor of __vector_obj expanded in it, and that
     * destructor is expanded only when it calls no inline function. */
    ~__vector_obj_imp();

    /* Matching workaround: begin(), end() and back() read the data pointer through __data(), as
     * __vector_imp's do: the game calls them out of line (begin() 0x8022400C and end() 0x80223FD8
     * for the DEFENSE_SYSTEM gadget's targets, back() 0x802EECC4 for the timer messages), so their
     * bodies call an inline function. __data() is the library's (the destructor's deallocation
     * calls it out of line, 0x8022521C), but what begin(), end() and back() called is not known;
     * revisit when it is. */
    iterator begin() {
        return __data();
    }
    iterator end() {
        return __data() + size_;
    }
    size_type capacity() const {
        return __cap();
    }
    size_type max_size() const {
        return __alloc().max_size();
    }
    value_type &back() {
        return *(__data() + size_ - 1);
    }
    void pop_back() {
        __alloc().destroy(data_ + --size_);
    }

    void reserve(size_type n);
    void push_back(const value_type &x) {
        insert(end(), 1, x);
    }
    void insert(iterator position, size_type n, const value_type &x);
    bool empty() const {
        return size_ == 0;
    }
    iterator erase(iterator position);
    iterator erase(iterator first, iterator last);
    void clear() {
        iterator first = data_;
        iterator last = data_ + size_;
        while (last > first) {
            __alloc().destroy(--last);
        }
        size_ = 0;
    }

    /* reserve and insert exchange the new storage through swap(x, y) below, which calls this
     * (0x80224DA4 and 0x80224DC4). */
    void swap(__vector_obj_imp &x) {
        if (this != &x) {
            std::swap(cap_, x.cap_);
            std::swap(data_, x.data_);
            std::swap(size_, x.size_);
        }
    }

  private:
    /* Copying is unrecovered in this partial interface: no copy of an object vector has been
     * identified in the game's code. The vector owns data_, so a memberwise copy would destroy
     * the same elements and free the same buffer twice. Declared only (as in C++03), which also
     * makes an implicit copy of vector, and of any class holding one, ill-formed. */
    __vector_obj_imp(const __vector_obj_imp &);
    __vector_obj_imp &operator=(const __vector_obj_imp &);

    T *&__data() {
        return data_;
    }
    size_type &__cap() {
        return cap_.first();
    }
    const size_type &__cap() const {
        return cap_.first();
    }
    Allocator &__alloc() {
        return cap_.second();
    }
    const Allocator &__alloc() const {
        return cap_.second();
    }

    __compressed_pair<size_type, Allocator> cap_;
    size_type size_;
    T *data_;
};

template <class T, class Allocator>
inline void swap(__vector_obj_imp<T, Allocator> &x, __vector_obj_imp<T, Allocator> &y) {
    x.swap(y);
}

template <class T, class Allocator> __vector_obj_imp<T, Allocator>::~__vector_obj_imp() {
    clear();
    if (__data() != 0) {
        __alloc().deallocate(__data(), __cap());
    }
}

template <class T, class Allocator>
typename __vector_obj_imp<T, Allocator>::iterator
__vector_obj_imp<T, Allocator>::erase(iterator position) {
    iterator old_end = end();
    if (old_end - position - 1 != 0) {
        __copy_objects(position + 1, old_end, position);
    }
    __alloc().destroy(data_ + --size_);
    return position;
}

template <class T, class Allocator>
typename __vector_obj_imp<T, Allocator>::iterator
__vector_obj_imp<T, Allocator>::erase(iterator first, iterator last) {
    if (first == last) {
        return first;
    }
    iterator old_end = end();
    size_type count = old_end - last;
    if (count != 0) {
        __copy_objects(last, old_end, first);
    }
    iterator new_end = first + count;
    while (new_end < old_end) {
        __alloc().destroy(new_end);
        ++new_end;
    }
    size_ -= last - first;
    return first;
}

template <class T, class Allocator> void __vector_obj_imp<T, Allocator>::reserve(size_type n) {
    if (n > capacity()) {
        if (n > max_size()) {
            fprintf(stderr, "vector::reserve length error\n");
            abort();
        }

        /* The new storage is built in a vector of its own and swapped in; its destructor then
         * releases the old elements. */
        __vector_obj_imp tmp(__alloc());
        tmp.data_ = tmp.__alloc().allocate(n);
        tmp.__cap() = n;

        T *destination = tmp.data_;
        T *source = begin();
        T *old_end = end();
        for (; source < old_end; ++source, ++destination) {
            tmp.__alloc().construct(destination, *source);
            ++tmp.size_;
        }
        std::swap(tmp, *this);
    }
}

template <class T, class Allocator>
void __vector_obj_imp<T, Allocator>::insert(iterator position, size_type n, const value_type &x) {
    if (n == 0) {
        return;
    }
    const size_type limit = max_size();
    if (n > limit || size_ > limit - n) {
        fprintf(stderr, "vector::insert length error\n");
        abort();
    }

    if (size_ + n <= capacity()) {
        iterator old_end = end();
        size_type elems_after = old_end - position;
        const value_type *value = &x;

        if (n > elems_after) {
            /* The new elements reach beyond the old end: the surplus copies of x and the old
             * tail go into raw storage, the rest are assigned. */
            iterator destination = old_end;
            for (; n > elems_after; ++destination, --n) {
                __alloc().construct(destination, x);
                ++size_;
            }
            for (iterator source = position; source < old_end; ++source, ++destination) {
                __alloc().construct(destination, *source);
                ++size_;
            }
        } else {
            iterator source = old_end - n;
            iterator destination = old_end;
            for (; source < old_end; ++source, ++destination) {
                __alloc().construct(destination, *source);
                ++size_;
            }
            size_type moved = elems_after - n;
            /* When x lies in [old_end - moved, old_end), read it n elements further up. */
            if (old_end - moved <= value && value < old_end) {
                value += n;
            }
            __copy_backward_objects(position, position + moved, old_end);
        }
        __fill_objects(position, n, *value);
    } else {
        __vector_obj_imp tmp(__alloc());
        size_type needed = size_ + n;
        size_type new_cap = __cap() != 0 ? __cap() : 1;
        while (needed > new_cap) {
            if (new_cap < limit / 2) {
                new_cap *= 2;
            } else {
                new_cap = limit;
            }
        }
        tmp.data_ = tmp.__alloc().allocate(new_cap);
        tmp.__cap() = new_cap;

        T *destination = tmp.data_;
        T *source = begin();
        T *old_end = end();
        for (; source < position; ++source, ++destination) {
            tmp.__alloc().construct(destination, *source);
            ++tmp.size_;
        }
        for (; n != 0; ++destination, --n) {
            tmp.__alloc().construct(destination, x);
            ++tmp.size_;
        }
        for (; source < old_end; ++source, ++destination) {
            tmp.__alloc().construct(destination, *source);
            ++tmp.size_;
        }
        std::swap(tmp, *this);
    }
}

/* The layer between a vector of objects and its implementation (placeholder name), as for the lists
 * of objects: the game's vector constructor (0x80224850 in the USA release) calls this layer's
 * (0x80224880), which calls the implementation's (0x802248B0). */
template <class T, class Allocator> class __vector_obj : public __vector_obj_imp<T, Allocator> {};

template <class T, class Allocator = allocator<T> > class vector;

/* A vector of objects. reserve and erase are expanded into their callers, which call the
 * implementation's directly. */
template <class T, class Allocator> class vector : private __vector_obj<T, Allocator> {
    typedef __vector_obj<T, Allocator> base;

  public:
    typedef size_t size_type;
    typedef T *iterator;

    iterator begin() {
        return base::begin();
    }
    iterator end() {
        return base::end();
    }
    bool empty() const {
        return base::empty();
    }
    T &back() {
        return base::back();
    }
    void push_back(const T &x) {
        base::push_back(x);
    }
    void pop_back() {
        base::pop_back();
    }
    iterator erase(iterator position) {
        return base::erase(position);
    }
    iterator erase(iterator first, iterator last) {
        return base::erase(first, last);
    }
    void clear() {
        base::clear();
    }
    void reserve(size_type n) {
        base::reserve(n);
    }
};

/* Only the default allocator is supported by the vector of unsigned long values (placeholder
 * name): it stores its values through the void-pointer vector and its default allocator, so any
 * other allocator leaves the type below undefined and fails to compile instead of being ignored. */
template <class Allocator> struct __vector_val_default_allocator;
template <> struct __vector_val_default_allocator<allocator<unsigned long> > {
    typedef int type;
};

template <class Allocator>
class vector<unsigned long, Allocator> : private __vector_val<unsigned long> {
    typedef typename __vector_val_default_allocator<Allocator>::type default_allocator_only;
    typedef __vector_val<unsigned long> base;

  public:
    typedef size_t size_type;
    typedef unsigned long *iterator;

    iterator begin() {
        return base::begin();
    }
    iterator end() {
        return base::end();
    }
    bool empty() const {
        return base::empty();
    }
    void clear() {
        base::clear();
    }
    void reserve(size_type n) {
        base::reserve(n);
    }
    void push_back(const unsigned long &x) {
        base::push_back(x);
    }
};

/* Only the default allocator is supported by the vectors of pointers: they store their values
 * through the void-pointer vector and its default allocator, so any other allocator leaves the
 * type below undefined and fails to compile instead of being ignored. */
template <class Allocator, class T> struct __vector_ptr_default_allocator;
template <class T> struct __vector_ptr_default_allocator<allocator<T *>, T> {
    typedef int type;
};

template <class T, class Allocator> class vector<T *, Allocator> : private __vector_ptr<T> {
    typedef typename __vector_ptr_default_allocator<Allocator, T>::type default_allocator_only;
    typedef __vector_ptr<T> base;

  public:
    typedef size_t size_type;
    typedef T **iterator;

    iterator begin() {
        return base::begin();
    }
    iterator end() {
        return base::end();
    }
    T *&back() {
        return base::back();
    }

    void reserve(size_type n) {
        base::reserve(n);
    }
    void push_back(T *const &x) {
        base::push_back(x);
    }
    void pop_back() {
        base::pop_back();
    }
    iterator erase(iterator position) {
        return base::erase(position);
    }
    void clear() {
        base::clear();
    }
};

} // namespace std

#endif
