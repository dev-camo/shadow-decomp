#ifndef STD_NEW_H_
#define STD_NEW_H_

#include <stdio>
#include <exception>

namespace std {

/* The exception for a failed allocation. The constructor, destructor and what() are all inline,
 * so every unit that needs the vtable emits its own weak copies of them, as for std::exception.
 * In the USA release the kept copies of its destructor and what() (0x8000D460, 0x8000DEDC) sit
 * among the weak copies in the game code, as std::exception's do, not in the library, and
 * FallBuildingHolder.cpp's .data keeps bad_alloc's base list and the space of its vtable where an
 * inline what() emits them. */
class bad_alloc : public exception {
  public:
    bad_alloc() {}
    virtual ~bad_alloc() {}
    virtual const char *what() const {
        return "bad_alloc";
    }
};

} // namespace std

inline void* operator new(size_t, void *ptr) { return ptr; }
inline void* operator new[](size_t, void* ptr) { return ptr; }

#endif
