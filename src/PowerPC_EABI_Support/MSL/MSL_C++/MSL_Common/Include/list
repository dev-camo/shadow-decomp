#ifndef MSL_LIST_H_
#define MSL_LIST_H_

#include <memory>
#include "layout_check.h"

/* The parts of <list> that the game uses so far: the list of pointers (the ElecSecurityCode list of
 * the ELEC_SECURITY gadget) and the list of objects (see __list_obj_imp below).
 *
 * Every list of pointers is implemented by the list of void pointers, through a private base, as
 * the vectors of pointers are: the GameCube code has, for each pointer type, an out-of-line copy
 * of the list's constructor, destructor, begin, end, erase and push_back and of each member of its
 * iterator, each calling the void-pointer layer, and one shared copy of each void-pointer member
 * (in the USA release the constructor 0x8001BE04, the destructors 0x8001B5B8 and 0x8001B604, begin
 * 0x8001B6B0, end 0x8001B674, size 0x80058F00 and push_back 0x8001D820). The names __list_imp,
 * __list_node_base and __list_node are placeholders: the library's names for these internal
 * classes are not recoverable from the game. The void-pointer layer has two levels, as its two
 * destructors show (the outer one only calls the inner one); modelling the outer level as a
 * specialisation list<void *> deriving from __list_imp is an assumption.
 *
 * The void-pointer constructor, insert and the range erase are only declared: the program uses the
 * game's own instances (0x8001BE04, 0x8001E528 and 0x8001BD24). */
namespace std {

/* The links of a list node; the sentinel node of a list is one of these. */
struct __list_node_base {
    __list_node_base *prev_;
    __list_node_base *next_;
};

template <class T> struct __list_node : public __list_node_base {
    T data_;
};
CHECK_SIZEOF(std::__list_node_base, 0x8);
CHECK_SIZEOF(std::__list_node<void *>, 0xC);

/* The list implementation: the size (paired with the node allocator), then the sentinel node
 * (paired with the allocator). The pairing is inferred: the game's constructor of the size pair
 * (0x8001BE90) is a separate function from the identical one of the vector's size pair
 * (0x80019AA0), so the two pairs have different types. __list_obj_imp below pairs them the other
 * way round; which pairing is right for this list is unresolved. */
template <class T, class Allocator> class __list_imp {
    typedef __list_node<T> node;
    typedef allocator<node> node_allocator;

  public:
    typedef T value_type;
    typedef size_t size_type;

    class iterator {
      public:
        iterator() {}
        iterator(__list_node_base *n) : node_(n) {}

        T &operator*() const {
            return static_cast<node *>(node_)->data_;
        }
        iterator &operator++() {
            node_ = node_->next_;
            return *this;
        }
        bool operator!=(const iterator &other) const {
            return node_ != other.node_;
        }

      private:
        friend class __list_imp;

        __list_node_base *node_;
    };

    __list_imp();
    ~__list_imp() {
        erase(begin(), end());
    }

    iterator begin() {
        return iterator(__tail()->next_);
    }
    iterator end() {
        return iterator(__tail());
    }
    size_type size() const {
        return __size();
    }
    /* Native void-pointer providers; their bodies are not recovered here. */
    void clear();
    void remove(const value_type &x);
    void push_back(const value_type &x) {
        insert(end(), x);
    }
    iterator insert(iterator position, const value_type &x);
    iterator erase(iterator position);
    iterator erase(iterator first, iterator last);

  private:
    /* Not copyable: a copy of the sentinel's links would leave the copy pointing into this list's
     * nodes. Declared and left undefined: no copy of a list of pointers is known in the game. */
    __list_imp(const __list_imp &);
    __list_imp &operator=(const __list_imp &);

    __list_node_base *__tail() {
        return &tail_.first();
    }
    size_type &__size() {
        return size_.first();
    }
    const size_type &__size() const {
        return size_.first();
    }
    node_allocator &__node_alloc() {
        return size_.second();
    }
    Allocator &__alloc() {
        return tail_.second();
    }

    __compressed_pair<size_type, node_allocator> size_;
    __compressed_pair<__list_node_base, Allocator> tail_;
};

template <class T, class Allocator>
typename __list_imp<T, Allocator>::iterator __list_imp<T, Allocator>::erase(iterator position) {
    __list_node_base *n = position.node_;
    ++position;
    n->prev_->next_ = n->next_;
    n->next_->prev_ = n->prev_;
    node_allocator &na = __node_alloc();
    __alloc().destroy(&static_cast<node *>(n)->data_);
    na.deallocate(static_cast<node *>(n), 1);
    --__size();
    return position;
}

template <class T, class Allocator = allocator<T> > class list;

/* The implementation of the lists of objects (the falling stones of the STONE_POLE gadget). It is a
 * template of its own rather than __list_imp because the program's void-pointer list members stay
 * declarations: the original ElecSecurityCodeGenerator object has no copy of the void-pointer
 * insert (its .rodata lacks insert's "Memory allocation failure" message), and the compiler still
 * instantiates a member that a header defines for void * when it is declared as an explicit
 * specialisation. The layout is __list_imp's. The value allocator is paired with the size and the
 * node allocator with the sentinel node, as in the tree of <map>: erase destroys values through
 * the allocator at 0x0 and frees nodes through the one at 0x4, and insert allocates nodes through
 * the one at 0x4. The names __list_obj_imp and __list_obj are placeholders. */
/* Only the default allocator is supported by the list of objects for now. Other allocators leave
 * the type below undefined; their layout and state propagation have not been recovered. */
template <class Allocator, class T> struct __list_obj_default_allocator;
template <class T> struct __list_obj_default_allocator<allocator<T>, T> {
    typedef int type;
};

template <class T, class Allocator> class __list_obj_imp {
    typedef typename __list_obj_default_allocator<Allocator, T>::type default_allocator_only;
    typedef __list_node<T> node;
    typedef typename Allocator::template rebind<node>::other node_allocator;

  public:
    typedef T value_type;
    typedef size_t size_type;

    class iterator {
      public:
        iterator() {}
        iterator(__list_node_base *n) : node_(n) {}
        /* User-declared: the game passes the iterators that begin and end return straight on as
         * by-value arguments. With the implicit copy constructor each one is first copied to a
         * second stack slot (clear and the destructor then take 0x30-byte frames instead of the
         * game's 0x20). */
        iterator(const iterator &x) : node_(x.node_) {}

        T &operator*() const {
            return static_cast<node *>(node_)->data_;
        }
        T *operator->() const {
            return &static_cast<node *>(node_)->data_;
        }
        iterator &operator++() {
            node_ = node_->next_;
            return *this;
        }
        iterator operator++(int) {
            iterator tmp(*this);
            node_ = node_->next_;
            return tmp;
        }
        bool operator==(const iterator &other) const {
            return node_ == other.node_;
        }
        bool operator!=(const iterator &other) const {
            return node_ != other.node_;
        }

      private:
        friend class __list_obj_imp;

        __list_node_base *node_;
    };

    __list_obj_imp();
    ~__list_obj_imp() {
        erase(begin(), end());
    }

    iterator begin() {
        return iterator(__tail()->next_);
    }
    iterator end() {
        return iterator(__tail());
    }
    bool empty() const {
        return __size() == 0;
    }
    void clear() {
        erase(begin(), end());
    }
    void push_back(const value_type &x) {
        insert(end(), x);
    }
    iterator insert(iterator position, const value_type &x);
    iterator erase(iterator position);
    iterator erase(iterator first, iterator last);

  private:
    /* Not copyable: a copy of the sentinel's links would leave the copy pointing into this list's
     * nodes. Declared and left undefined: no copy of a list of objects is known in the game. */
    __list_obj_imp(const __list_obj_imp &);
    __list_obj_imp &operator=(const __list_obj_imp &);

    __list_node_base *__tail() {
        return &tail_.first();
    }
    size_type &__size() {
        return size_.first();
    }
    const size_type &__size() const {
        return size_.first();
    }
    Allocator &__alloc() {
        return size_.second();
    }
    node_allocator &__node_alloc() {
        return tail_.second();
    }

    __compressed_pair<size_type, Allocator> size_;
    __compressed_pair<__list_node_base, node_allocator> tail_;
};

/* The node allocator is converted from the value allocator before the sentinel is initialized. */
template <class T, class Allocator>
__list_obj_imp<T, Allocator>::__list_obj_imp() : size_(0), tail_(node_allocator(__alloc())) {
    __list_node_base *t = __tail();
    t->prev_ = t->next_ = t;
}

template <class T, class Allocator>
typename __list_obj_imp<T, Allocator>::iterator
__list_obj_imp<T, Allocator>::insert(iterator position, const value_type &x) {
    __node_holder<node, node_allocator, __constant_size<1> > hold(__node_alloc().allocate(1),
                                                                  __node_alloc());
    __alloc().construct(&hold->data_, x);

    node *n = hold.release();
    __list_node_base *p = position.node_;
    p->prev_->next_ = n;
    n->prev_ = p->prev_;
    p->prev_ = n;
    n->next_ = p;
    ++__size();
    return iterator(n);
}

template <class T, class Allocator>
typename __list_obj_imp<T, Allocator>::iterator
__list_obj_imp<T, Allocator>::erase(iterator position) {
    __list_node_base *n = position.node_;
    ++position;
    n->prev_->next_ = n->next_;
    n->next_->prev_ = n->prev_;
    __alloc().destroy(&static_cast<node *>(n)->data_);
    __node_alloc().deallocate(static_cast<node *>(n), 1);
    --__size();
    return position;
}

template <class T, class Allocator>
typename __list_obj_imp<T, Allocator>::iterator __list_obj_imp<T, Allocator>::erase(iterator first,
                                                                                    iterator last) {
    if (first == last) {
        return last;
    }
    __list_node_base *f = first.node_;
    __list_node_base *l = last.node_->prev_;
    f->prev_->next_ = l->next_;
    l->next_->prev_ = f->prev_;
    while (first != last) {
        __alloc().destroy(&*first);
        __list_node_base *n = first.node_;
        ++first;
        __node_alloc().deallocate(static_cast<node *>(n), 1);
        --__size();
    }
    return last;
}

/* The layer between a list of objects and its implementation: the game's code has three levels of
 * destructors for these lists (the list's, this layer's and __list_obj_imp's), as for the lists
 * of pointers (list<T *>, list<void *> and __list_imp). */
template <class T, class Allocator> class __list_obj : public __list_obj_imp<T, Allocator> {};

/* A list of objects. */
template <class T, class Allocator> class list : public __list_obj<T, Allocator> {};

/* The list of void pointers that implements every list of pointers. */
template <class Allocator> class list<void *, Allocator> : public __list_imp<void *, Allocator> {};

/* A list of T pointers stored as void pointers. */
template <class T, class Allocator>
class list<T *, Allocator> : private list<void *, allocator<void *> > {
    typedef list<void *, allocator<void *> > base;
    typedef base::iterator base_iterator;

  public:
    typedef size_t size_type;

    class iterator {
      public:
        iterator() {}
        iterator(const base_iterator &i) : i_(i) {}
        /* User-declared: the game copies these iterators with an out-of-line call. */
        iterator(const iterator &x) : i_(x.i_) {}

        T *&operator*() const {
            return (T *&)*i_;
        }
        iterator &operator++() {
            ++i_;
            return *this;
        }
        iterator operator++(int) {
            iterator tmp(*this);
            ++i_;
            return tmp;
        }
        operator base_iterator() const {
            return i_;
        }

        friend bool operator!=(const iterator &x, const iterator &y) {
            return x.i_ != y.i_;
        }

      private:
        base_iterator i_;
    };

    iterator begin() {
        return iterator(base::begin());
    }
    iterator end() {
        return iterator(base::end());
    }
    using base::clear;
    using base::size;
    void remove(T *const &x);
    void push_back(T *const &x) {
        base::push_back((void *const &)x);
    }
    iterator erase(iterator position) {
        return iterator(base::erase(position));
    }
};

/* Out of class to retain the typed call and separate copy seen in the original. */
template <class T, class Allocator> void list<T *, Allocator>::remove(T *const &x) {
    base::remove(x);
}

} // namespace std

#endif
