#ifndef MSL_MEMORY_H_
#define MSL_MEMORY_H_

#include <new>
#include <cstdlib>
#include <limits>
#include <utility>

namespace std {

template <class T> struct auto_ptr_ref {
    explicit auto_ptr_ref(T *pointer) throw() : ptr(pointer) {}

    T *ptr;
};

template <class T> class auto_ptr {
  public:
    typedef T element_type;

    explicit auto_ptr(T *pointer = 0) throw() : ptr(pointer) {}
    auto_ptr(auto_ptr &source) throw() : ptr(source.release()) {}
    template <class U> auto_ptr(auto_ptr<U> &source) throw() : ptr(source.release()) {}

    auto_ptr &operator=(auto_ptr &source) throw() {
        reset(source.release());
        return *this;
    }

    template <class U> auto_ptr &operator=(auto_ptr<U> &source) throw() {
        reset(source.release());
        return *this;
    }

    ~auto_ptr() throw() {
        delete ptr;
    }

    T &operator*() const throw() {
        return *ptr;
    }

    T *operator->() const throw() {
        return ptr;
    }

    T *get() const throw() {
        return ptr;
    }

    T *release() throw() {
        T *value = ptr;
        ptr = 0;
        return value;
    }

    void reset(T *replacement = 0) throw() {
        if (ptr != replacement) {
            delete ptr;
            ptr = replacement;
        }
    }

    auto_ptr(auto_ptr_ref<T> source) throw() : ptr(source.ptr) {}

    auto_ptr &operator=(auto_ptr_ref<T> source) throw() {
        reset(source.ptr);
        return *this;
    }

    template <class U> operator auto_ptr_ref<U>() throw() {
        return auto_ptr_ref<U>(release());
    }

    template <class U> operator auto_ptr<U>() throw() {
        return auto_ptr<U>(release());
    }

  private:
    T *ptr;
};

// The uninitialized_* templates below are unused and unverified (the copy helper assigns instead of
// constructing). Deleting an unused template renumbers the compiler's @N labels in several Game
// objects (no code or data bytes change), which needs a symbol rename pass over those units first.
template <class ForwardIt, class Size, class T>
inline void uninitialized_fill_n(ForwardIt first, Size count, const T &value) {
    for (; count--; ++first) {
        new (first) T(value);
    }
}

template <class InputIterator, class ForwardIterator>
inline ForwardIterator __uninitialized_copy(InputIterator first, InputIterator last,
                                            ForwardIterator result) {
    for (; first != last; ++first, ++result) {
        *result = *first;
    }
    return result;
}

template <class T, bool A, bool B> struct __uninitialized_copy_helper {
    static T *uninitialized_copy(T *first, T *last, T *result) {
        return __uninitialized_copy(first, last, result);
    }
};

template <class T> struct __uninitialized_copy_helper<T, true, false> {
    static T *uninitialized_copy(T *first, T *last, T *result) {
        for (; first < last; ++result, ++first) {
            *result = *first;
        }
        return result;
    }
};

template <class T> inline T *uninitialized_copy(T *first, T *last, T *result) {
    return __uninitialized_copy_helper<T, true, false>::uninitialized_copy(first, last, result);
}

/* With exceptions off, the library reports a failure on stderr and aborts. */
inline void __msl_error(const char *message) {
    fprintf(stderr, message);
    abort();
}

template <class T> class allocator {
  public:
    typedef size_t size_type;
    typedef T *pointer;

    allocator() {}
    template <class U> allocator(const allocator<U> &) {}

    template <class U> struct rebind {
        typedef allocator<U> other;
    };

    pointer allocate(size_type n, const void *hint = 0) {
        pointer p = static_cast<pointer>(::operator new(n * sizeof(T)));
        if (p == 0) {
            __msl_error("Memory allocation failure");
        }
        return p;
    }
    void deallocate(pointer p, size_type n) {
        ::operator delete(p);
    }
    /* The game has an out-of-line copy per element type (0x80225088 in the USA release, for the
     * vector of the DEFENSE_SYSTEM gadget's targets), so its body calls an inline function. */
    size_type max_size() const {
        return numeric_limits<size_type>::max() / sizeof(T);
    }
    void construct(pointer p, const T &value) {
        ::new (static_cast<void *>(p)) T(value);
    }
    void destroy(pointer p) {
        p->~T();
    }
};

/* A pair whose second member is usually an empty class (an allocator), stored as a base class so
 * that it takes no space; the containers keep their sizes and allocators in one. The names of this
 * pair and its base are placeholders: the library's names are not recoverable from the game. */
template <class T1, class T2> class __compressed_pair_imp : private T2 {
  public:
    __compressed_pair_imp(T1 x) : T2(), first_(x) {}
    __compressed_pair_imp(const T2 &y, T1 x) : T2(y), first_(x) {}
    __compressed_pair_imp(const T2 &y) : T2(y) {}

    T1 &first() {
        return first_;
    }
    const T1 &first() const {
        return first_;
    }
    T2 &second() {
        return *this;
    }
    const T2 &second() const {
        return *this;
    }

    /* Exchanges the first members only, so it is restricted to an empty second member, which holds
     * no state: a pair no larger than its first member has an empty base, and any other pair fails
     * to compile here. (Exchanging the base as well calls std::swap for the allocator out of line,
     * which the game's swap, 0x80224E5C in the USA release, does not.) */
    void swap(__compressed_pair_imp &x) {
        typedef char second_member_is_empty[sizeof(__compressed_pair_imp) == sizeof(T1) ? 1 : -1];
        std::swap(first_, x.first_);
    }

  private:
    T1 first_;
};

template <class T1, class T2> class __compressed_pair : public __compressed_pair_imp<T1, T2> {
    typedef __compressed_pair_imp<T1, T2> base;

  public:
    __compressed_pair(T1 x) : base(x) {}
    __compressed_pair(const T2 &y, T1 x) : base(y, x) {}
    __compressed_pair(const T2 &y) : base(y) {}
    /* Declared: the game copies the node holder's pointer pair with an out-of-line call (0x800DC23C
     * in the USA release), which an implicit copy would do in place. */
    __compressed_pair(const __compressed_pair &x) : base(x) {}

    void swap(__compressed_pair &x) {
        base::swap(x);
    }
};

/* The vector of objects exchanges its capacity pairs through this, the pair's swap and its base's
 * (0x80224E1C, 0x80224E3C and 0x80224E5C in the USA release). */
template <class T1, class T2>
inline void swap(__compressed_pair<T1, T2> &x, __compressed_pair<T1, T2> &y) {
    x.swap(y);
}

/* A pair whose second member is a reference: both are members, the reference first, so the layout
 * is the one the general pair has with its second member as a base (used by __node_holder). */
template <class T1, class T2> class __compressed_pair_imp<T1, T2 &> {
  public:
    __compressed_pair_imp(T2 &y, const T1 &x) : second_(y), first_(x) {}

    T1 &first() {
        return first_;
    }
    T2 &second() {
        return second_;
    }

  private:
    T2 &second_;
    T1 first_;
};

template <class T1, class T2>
class __compressed_pair<T1, T2 &> : public __compressed_pair_imp<T1, T2 &> {
    typedef __compressed_pair_imp<T1, T2 &> base;

  public:
    __compressed_pair(T2 &y, const T1 &x) : base(y, x) {}
};

/* An empty type that converts to the constant N (placeholder name; see __node_holder). */
template <size_t N> struct __constant_size {
    operator size_t() const {
        return N;
    }
};

/* Owns objects allocated from a, which it deallocates unless they are released (placeholder name;
 * the insert of the lists of objects holds its new node in one). The allocator reference and the
 * pointer with its count are kept in nested pairs, in the layout of the game's copies (0x800DBF24
 * to 0x800DC258 in the USA release): the reference at 0x0, the pointer at 0x4. */
template <class T, class Allocator, class Size> class __node_holder {
    typedef __compressed_pair<T *, Size> pointer_pair;

  public:
    __node_holder(T *p, Allocator &a, Size n = Size()) : pair_(a, pointer_pair(n, p)) {}
    ~__node_holder() {
        if (get() != 0) {
            alloc().deallocate(get(), size());
        }
    }

    T *get() {
        return pair_.first().first();
    }
    T *operator->() {
        return get();
    }
    T *release() {
        T *p = get();
        pair_.first().first() = 0;
        return p;
    }

  private:
    /* Not copyable: a copy would deallocate the same objects a second time. Declared and left
     * undefined: no copy of a node holder is known in the game. */
    __node_holder(const __node_holder &);
    __node_holder &operator=(const __node_holder &);

    Allocator &alloc() {
        return pair_.second();
    }
    size_t size() {
        return pair_.first().second();
    }

    __compressed_pair<pointer_pair, Allocator &> pair_;
};

} // namespace std

#endif
