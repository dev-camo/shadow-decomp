#ifndef MSL_MEMORY_H_
#define MSL_MEMORY_H_

#include <new>
#include <cstdlib>

namespace std {

template <class T> struct auto_ptr_ref {
    explicit auto_ptr_ref(T *pointer) throw() : ptr(pointer) {}

    T *ptr;
};

template <class T> class auto_ptr {
  public:
    typedef T element_type;

    explicit auto_ptr(T *pointer = 0) throw() : ptr(pointer) {}
    auto_ptr(auto_ptr &source) throw() : ptr(source.release()) {}
    template <class U> auto_ptr(auto_ptr<U> &source) throw() : ptr(source.release()) {}

    auto_ptr &operator=(auto_ptr &source) throw() {
        reset(source.release());
        return *this;
    }

    template <class U> auto_ptr &operator=(auto_ptr<U> &source) throw() {
        reset(source.release());
        return *this;
    }

    ~auto_ptr() throw() {
        delete ptr;
    }

    T &operator*() const throw() {
        return *ptr;
    }

    T *operator->() const throw() {
        return ptr;
    }

    T *get() const throw() {
        return ptr;
    }

    T *release() throw() {
        T *value = ptr;
        ptr = 0;
        return value;
    }

    void reset(T *replacement = 0) throw() {
        if (ptr != replacement) {
            delete ptr;
            ptr = replacement;
        }
    }

    auto_ptr(auto_ptr_ref<T> source) throw() : ptr(source.ptr) {}

    auto_ptr &operator=(auto_ptr_ref<T> source) throw() {
        reset(source.ptr);
        return *this;
    }

    template <class U> operator auto_ptr_ref<U>() throw() {
        return auto_ptr_ref<U>(release());
    }

    template <class U> operator auto_ptr<U>() throw() {
        return auto_ptr<U>(release());
    }

  private:
    T *ptr;
};

// The uninitialized_* templates below are unused and unverified (the copy helper assigns instead of
// constructing). Deleting an unused template renumbers the compiler's @N labels in several Game
// objects (no code or data bytes change), which needs a symbol rename pass over those units first.
template <class ForwardIt, class Size, class T>
inline void uninitialized_fill_n(ForwardIt first, Size count, const T &value) {
    for (; count--; ++first) {
        new (first) T(value);
    }
}

template <class InputIterator, class ForwardIterator>
inline ForwardIterator __uninitialized_copy(InputIterator first, InputIterator last,
                                            ForwardIterator result) {
    for (; first != last; ++first, ++result) {
        *result = *first;
    }
    return result;
}

template <class T, bool A, bool B> struct __uninitialized_copy_helper {
    static T *uninitialized_copy(T *first, T *last, T *result) {
        return __uninitialized_copy(first, last, result);
    }
};

template <class T> struct __uninitialized_copy_helper<T, true, false> {
    static T *uninitialized_copy(T *first, T *last, T *result) {
        for (; first < last; ++result, ++first) {
            *result = *first;
        }
        return result;
    }
};

template <class T> inline T *uninitialized_copy(T *first, T *last, T *result) {
    return __uninitialized_copy_helper<T, true, false>::uninitialized_copy(first, last, result);
}

/* With exceptions off, the library reports a failure on stderr and aborts. */
inline void __msl_error(const char *message) {
    fprintf(stderr, message);
    abort();
}

template <class T> class allocator {
  public:
    typedef size_t size_type;
    typedef T *pointer;

    allocator() {}

    template <class U> struct rebind {
        typedef allocator<U> other;
    };

    pointer allocate(size_type n, const void *hint = 0) {
        pointer p = static_cast<pointer>(::operator new(n * sizeof(T)));
        if (p == 0) {
            __msl_error("Memory allocation failure");
        }
        return p;
    }
    void deallocate(pointer p, size_type n) {
        ::operator delete(p);
    }
    void construct(pointer p, const T &value) {
        new (static_cast<void *>(p)) T(value);
    }
    void destroy(pointer p) {
        p->~T();
    }
};

/* A pair whose second member is usually an empty class (an allocator), stored as a base class so
 * that it takes no space; the containers keep their sizes and allocators in one. The names of this
 * pair and its base are placeholders: the library's names are not recoverable from the game. */
template <class T1, class T2> class __compressed_pair_imp : private T2 {
  public:
    __compressed_pair_imp(T1 x) : T2(), first_(x) {}
    __compressed_pair_imp(const T2 &y, T1 x) : T2(y), first_(x) {}
    __compressed_pair_imp(const T2 &y) : T2(y) {}

    T1 &first() {
        return first_;
    }
    const T1 &first() const {
        return first_;
    }
    T2 &second() {
        return *this;
    }

  private:
    T1 first_;
};

template <class T1, class T2> class __compressed_pair : public __compressed_pair_imp<T1, T2> {
    typedef __compressed_pair_imp<T1, T2> base;

  public:
    __compressed_pair(T1 x) : base(x) {}
    __compressed_pair(const T2 &y, T1 x) : base(y, x) {}
    __compressed_pair(const T2 &y) : base(y) {}
};

} // namespace std

#endif
